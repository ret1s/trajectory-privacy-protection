# Python
__pycache__/
*.pyc
*.egg-info/

# Virtual environments
venv/
.venv/

# OSM / road network caches (regenerated on demand)
cache/
road_network_cache/

# Raw datasets (downloaded on demand — see data/README.md)
data/raw/
# Expanded SUMO evidence is tracked as dataset.json.gz; restore with the archive helper.
artifacts/datasets/endpoint_holdout_expanded_v1/dataset.json

# LaTeX build artifacts (PDF deliverables are kept)
*.aux
*.log
*.out
*.toc
*.lof
*.lot
*.bbl
*.blg
*.fls
*.xdv
*.fdb_latexmk
thesis/main.pdf

# Local render/QA scratch artifacts
tmp/
build/
.pytest_cache/

# SQLite transaction sidecars are local, never checkpoint these into Git.
*.sqlite3-journal
*.sqlite3-wal
*.sqlite3-shm

# Private evaluator RNG master keys stay local; publish transcripts/receipts.
artifacts/benchmarks/**/evaluator_randomness.json.gz
artifacts/benchmarks/**/evaluator_shuffle_randomness.json.gz
# Original protected evaluator bundles contain resolved private sampler seeds.
artifacts/benchmarks/endpoint_generalization_20261005/*-scale025_L20.json.gz
artifacts/benchmarks/endpoint_generalization_20261005/*-scale100_L10.json.gz
artifacts/benchmarks/endpoint_generalization_20261005/*-scale100_L20.json.gz

# OS / editor junk
.DS_Store
.idea/
.claude/settings.local.json
